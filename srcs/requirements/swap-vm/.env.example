# ⚠️ The SINGLE source of truth for the whole project is `../../../.env.example` (repo
# root). This file is the swap-vm-scoped subset; `srcs/requirements/swap-vm/.env` is a
# symlink to the root `.env`. See the root file for the full contract.

OPS_AQUA_ADDRESS="0x0000000000000000000000000000000000000000"
OPS_SWAP_VM_ROUTER_NAME="SwapVMRouter"
OPS_SWAP_VM_ROUTER_VERSION="1.0.0"
OPS_NETWORK="localhost"
OPS_CHAIN_ID="31337"

# RPC URL for localhost network
LOCALHOST_RPC_URL=http://localhost:8546
# Replace with your own private key for localhost testing
LOCALHOST_PRIVATE_KEY=0x

# Mainnet RPC URL for localhost testing with Anvil
NODE_URL=https://eth.drpc.org

# ─────────────────────────────────────────────────────────────────────
# wave — Sepolia live-swap leg (milestone 1, step 4c)
#
# Copy this file to `.env` (gitignored) and fill in. The Makefile
# `-include .env` + `export` (lines 4-10), so these reach both `make`
# and `forge script`. The Makefile derives the two SEPOLIA_* names from
# OPS_NETWORK — set OPS_NETWORK=sepolia and it looks up SEPOLIA_RPC_URL
# and SEPOLIA_PRIVATE_KEY automatically.
#
# ⚠️  Use FRESH throwaway keys (`cast wallet new`), never a personal
#     wallet — this file is shared tooling, not a vault.
# ⚠️  Always confirm `cast wallet address --private-key $KEY` matches the
#     address you funded BEFORE broadcasting. A mismatch on a public
#     testnet costs real funds; there is no anvil_setBalance to save you.
# ─────────────────────────────────────────────────────────────────────

# --- Sepolia network (uncomment the OPS_* overrides above when using) ---
# OPS_NETWORK="sepolia"
# OPS_CHAIN_ID="11155111"
# OPS_SWAP_VM_ROUTER_NAME="Wave"
# OPS_SWAP_VM_ROUTER_VERSION="1"

SEPOLIA_RPC_URL=""
# Deployer + maker. Needs ~0.1 ETH (measured: 7.2M gas total for the
# three runs, plus 0.02 ETH the script forwards to the taker EOA).
SEPOLIA_PRIVATE_KEY=""

# --- LiveSwapStock.s.sol reads these directly via vm.envUint/envAddress ---
# MAKER_PRIVATE_KEY is normally the same key as SEPOLIA_PRIVATE_KEY.
# TAKER_PRIVATE_KEY is a SECOND key: the swap must come from a plain EOA
# that is not the maker. It needs no funding — the script forwards it
# 0.02 ETH for gas if empty.
MAKER_PRIVATE_KEY=""
TAKER_PRIVATE_KEY=""

# Filled in from the output of steps 1 and 2 of the deploy sequence.
AQUA_ADDRESS=""
ROUTER_ADDRESS=""

# Optional: leave unset and the script deploys fresh TokenMocks and mints
# to both parties — no real WETH/USDC or token faucet needed.
# TOKEN_A=""
# TOKEN_B=""
# STRATEGY_SALT="1"
