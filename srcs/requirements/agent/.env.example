# Self-hosted LLM (OpenAI-compatible vLLM endpoint, e.g. Gemma4-fast).
# baseURL is the BASE (…/v1), NOT …/chat/completions — the SDK appends the path.
# think:false is injected in code (src/mastra/llm.ts) so it is NOT set here.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=dummy
LLM_MODEL=Gemma4-fast

# LibSQL storage. ':memory:' for smoke; a real libsql URL for durable HITL runs.
LIBSQL_URL=:memory:

# HTTP port the agent exposes (Next.js UI calls AGENT_URL=http://agent:<port>).
PORT=3002

# The Graph subgraph query endpoint. Default is the live Studio deployment
# (path A, see docs/spikes/GRAPH-NODE-SPIKE.md). Override for self-hosted
# graph-node (path B) or a different Studio version.
WAVE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1756983/wave/v0.0.1
