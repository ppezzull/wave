# ⚠️ The SINGLE source of truth for the whole project is `../../../.env.example` (repo
# root). This file is the agent-scoped subset; `srcs/requirements/agent/.env` is a
# symlink to the root `.env`. See the root file for the full contract.
#
# LLM via the craftshost OpenAI-compat gateway (Langfuse-traced, Cloudflare-fronted).
# Auth:  Authorization = Bearer <ZAI_API_KEY = secret key>
#        X-Langfuse-Public-Key = <ZAI_PUBLIC_KEY = public key>
# Cloudflare blocks non-browser UAs — the browser UA is injected in src/mastra/llm.ts.
# Working model: deepseek-coder-v2 (NON-thinking). gemma4-fast / qwen3 / fast-nt are
# thinking models whose reasoning can't be disabled (think:false is ignored) → unusable.
ZAI_BASE_URL=https://openai.craftshost.com/v1
ZAI_API_KEY=sk-lf-YOUR-SECRET-KEY
ZAI_PUBLIC_KEY=pk-lf-YOUR-PUBLIC-KEY
ZAI_MODEL=deepseek-coder-v2:16b-lite-instruct-q4_K_M

# LLM call resilience (TIER 2 #6) — timeoutMs guards against craftshost stalls
# (demo-critical); maxRetries handles transient 5xx/429/connection errors.
LLM_TIMEOUT_MS=90000
LLM_MAX_RETRIES=2

# LibSQL storage — ':memory:' boots with no writable volume (container-safe default).
# For durability (HITL suspend/resume + memory recall surviving restarts) set
# LIBSQL_URL=file:./data.db in the DEPLOY env once the TIER 1 named volume is mounted.
LIBSQL_URL=:memory:

# HTTP port the agent exposes (Next.js UI calls AGENT_URL=http://agent:<port>).
PORT=3002

# The Graph subgraph query endpoint. Default is the live production Studio
# deployment v0.0.4 (issue #51). Override for self-hosted graph-node or another
# Studio version.
WAVE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1756983/wave/v0.0.4

# Monitor delta source (PR #47). `subgraph` = live subgraphDeltaSource;
# unset/other = stub (synthetic) for offline tests.
MONITOR_SOURCE=subgraph

# Announcer key — the agent announces strategies from the router OWNER EOA
# (EnsStrategyRouter.announceStrategy() is onlyOwner). MUST derive to the owner
# 0x2058C253029bB0Cf1E1aD43DfAEF63D658A8dddf; validated at boot (fail-fast).
# Leave empty here — set the real throwaway faucet key in .env (gitignored).
# Falls back to SEPOLIA_PRIVATE_KEY / MAKER_PRIVATE_KEY if unset.
ANNOUNCER_PRIVATE_KEY=

# ── ENS (Sepolia) — identity layer. No hard-coded addresses: viem's sepolia preset supplies
#    the Universal Resolver; the RPC, parent name, router + registry come from here. ──
# Sepolia RPC endpoint (reads + writes).
SEPOLIA_RPC_URL=
# Parent 2LD subnames mint under (must be registered + owned by the wallet below).
ENS_PARENT_NAME=wave.eth
# Deployed EnsStrategyRouter — the ENSIP-25 <registry> (ERC-7930-encoded) + StrategyDeployed emitter.
ENS_STRATEGY_ROUTER=0xeb513fd18c391fae1513ff12c1f97bf659d052c4
# ENS Registry — setSubnodeRecord target for subname minting. Leave empty to skip mint
# (record writes still work on an existing subname). Set to the active Sepolia ENS Registry.
ENS_REGISTRY=
# Wallet that owns the parent name (mints subnames + setText). Leave empty to reuse
# SEPOLIA_PRIVATE_KEY / MAKER_PRIVATE_KEY.
ENS_WALLET_PRIVATE_KEY=
# Value written to the ENSIP-26 agent-endpoint[mcp] record (the wave MCP server URL).
AGENT_ENDPOINT_MCP=http://agent:3002
