# wave — GLOBAL environment (single source of truth for the whole project).
#
# Copy to `.env` (gitignored) at the repo ROOT and fill the secrets. Every package
# reads this one file:
#   - agent/  → src/requirements/agent/.env is a SYMLINK to this file (dotenv reads it)
#   - swap-vm → src/requirements/swap-vm/.env is a SYMLINK to this file (Makefile -include .env)
#   - Docker  → srcs/docker-compose.yml uses `env_file: [ ../.env ]` on agent + swap-vm
#   - compiler / subgraph / ui read NO env (subgraph deploy auth is the .studio-auth FILE)
#
# Fresh-clone one-liner to create the symlinks (machine-local, gitignored):
#   ln -sf ../../../.env srcs/requirements/agent/.env
#   ln -sf ../../../.env srcs/requirements/swap-vm/.env
#
# `[secret]` = never commit / log / paste. Public addresses + URLs are filled with the
# verified Sepolia values; change per network.

# ─── Network / RPC ───────────────────────────────────────────────
# ⚠️ MUST support eth_getLogs. publicnode answers
#   "Archive requests require a personal token" (-32602) — which viem surfaces as
#   "Invalid parameters", naming nothing. That breaks resolveVerifyLive (G1, reads
#   StrategyDeployed via getLogs) and any log-based fallback.
#   drpc works unauthenticated for ranges <= 10k blocks (free plan rejects wider with
#   code 35) — which is why fetchOnChainProgramHash defaults to a 10k window. For an
#   older strategy, pass fromBlock near its announce block.
SEPOLIA_RPC_URL=https://sepolia.drpc.org
LOCALHOST_RPC_URL=http://127.0.0.1:8545
NODE_URL=                                # anvil fork source (make anvil)

# ─── swap-vm deploy orchestration (Makefile derives <PREFIX>_RPC_URL / _PRIVATE_KEY) ──
OPS_NETWORK=sepolia                      # → reads SEPOLIA_RPC_URL / SEPOLIA_PRIVATE_KEY
OPS_CHAIN_ID=11155111
OPS_LAUNCH_MODE=                         # =auto to use .env.automation instead of .env
OPS_SWAP_VM_ROUTER_NAME=SwapVMRouter
OPS_SWAP_VM_ROUTER_VERSION=1
OPS_AQUA_ADDRESS=0xdc8C2b141CF705F12f6BB45af3830341daBB1D1E
OPS_WETH_ADDRESS=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14

# ─── Deployed addresses (PUBLIC — same byte under both names so each lane's code is untouched) ──
# Router: swap-vm reads ROUTER_ADDRESS; agent reads ROUTER_ADDRESS (ENS_STRATEGY_ROUTER
# is a kept historical fallback alias — the ENS layer itself is removed).
ROUTER_ADDRESS=0x698d798895a03c858aab493564e0795732da0c68
ENS_STRATEGY_ROUTER=0x698d798895a03c858aab493564e0795732da0c68
# Aqua: swap-vm reads AQUA_ADDRESS / OPS_AQUA_ADDRESS — same address.
AQUA_ADDRESS=0xdc8C2b141CF705F12f6BB45af3830341daBB1D1E
# StrategyFactory: emits StrategyAttributed (on-chain authorship — task #31). The agent's
# deploy pipeline calls factory.attribute(strategyId, author) after announce. Live address
# lands with the #29 router+factory redeploy; until then ships stay unattributed.
FACTORY_ADDRESS=0xYOUR_STRATEGY_FACTORY_ADDRESS

# ─── Keys [secret] ───────────────────────────────────────────────
# Faucet throwaway; deploys swap-vm AND derives to the router owner (onlyOwner announcer).
SEPOLIA_PRIVATE_KEY=0xYOUR_SEPOLIA_PRIVATE_KEY            # = MAKER_PRIVATE_KEY (same key)
MAKER_PRIVATE_KEY=0xYOUR_SEPOLIA_PRIVATE_KEY
TAKER_PRIVATE_KEY=0xYOUR_TAKER_PRIVATE_KEY
LOCALHOST_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80  # anvil #0
# Announcer: leave blank → announcerConfig() falls back to SEPOLIA_PRIVATE_KEY.
# Set explicitly only if you use a distinct key.
ANNOUNCER_PRIVATE_KEY=

# ─── World / AgentKit (ETHOnline continuity — plan Fase 1) ────────
# Public identifiers (safe here — they ship in the frontend bundle too).
WORLD_APP_ID=app_d088df7139630c29e3182496bc4ac13e
WORLD_RP_ID=rp_6d0913d66cd84de6
# [secret] Developer Portal → World ID → signing key. Shown ONCE at
# "configure World ID"; if lost, rotate (this invalidates the old signer).
WORLD_SIGNING_KEY=
# AgentBook agent wallets — throwaway EOAs, one per role, registered via
# `npx @worldcoin/agentkit-cli register <address>` (one World ID verify each).
WORLD_AGENT_PUBLISHER_KEY=               # [secret] compose/ship arm
WORLD_AGENT_RETUNER_KEY=                 # [secret] autonomous retune arm
# x402 settlement chain for the AgentKit payment fallback (World Chain 480 / Base 8453).
WORLD_X402_CHAIN_ID=480

# ─── agent: testnet faucet (faucetDrip — the in-app "buffer wallet", PROD-TESTNET §4) ──
# Leave blank → falls back to ANNOUNCER → SEPOLIA → MAKER (same EOA in this deployment;
# compose only passes SEPOLIA_/MAKER_ so the deployed default IS the Sepolia key).
FAUCET_PRIVATE_KEY=
FAUCET_DRIP_ETH=0.05                     # per drip; a dozen swaps ≈ <0.01 ETH
FAUCET_COOLDOWN_HOURS=6                  # per address, in-memory (clears on restart)
FAUCET_MAX_TOTAL_ETH=2                   # per-process lifetime cap

# ─── agent: LLM (craftshost OpenAI-compat gateway) ───────────────
ZAI_BASE_URL=https://openai.craftshost.com/v1
ZAI_API_KEY=sk-lf-YOUR-SECRET-KEY            # [secret]
ZAI_PUBLIC_KEY=pk-lf-YOUR-PUBLIC-KEY         # [secret] (Langfuse X-header)
ZAI_MODEL=deepseek-coder-v2:16b-lite-instruct-q4_K_M
LLM_TIMEOUT_MS=90000
LLM_MAX_RETRIES=2

# ─── agent: runtime / storage ────────────────────────────────────
LIBSQL_URL=:memory:                          # file:./data.db for durability (needs compose volume)
PORT=3002
EVIDENCE_PATH=./evidence.jsonl

# ─── agent: MCP endpoint ─────────────────────────────────────────
AGENT_ENDPOINT_MCP=http://agent:3002

# ─── subgraph query URL (the AGENT reads this to call the subgraph) ──
WAVE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1756983/wave/v0.0.1

# ─── ui (compose injects COMPILER_URL today; AGENT_URL for the future Next.js app) ──
COMPILER_URL=http://compiler:3001
AGENT_URL=http://agent:3002
